# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Project Settings > API. Server-only, never expose
# to the browser. Used to bootstrap clinics and invite teammates.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build email confirmation / password reset links.
# Optional locally (falls back to the request host); set explicitly in
# production (e.g. https://app.esteticaos.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Cobrança — Cakto (opcional)
#
# Nada aqui é obrigatório para rodar o sistema. Sem estas variáveis, a
# tela de Plano mostra o preço normalmente e o botão avisa que o
# pagamento ainda está sendo liberado. Assinatura só é marcada como paga
# por confirmação do provedor, nunca pela interface.
#
# Passo a passo do painel da Cakto: docs/cakto.md
# ---------------------------------------------------------------------

# Links de checkout do produto "EstéticaOS Completo", um por ciclo.
# Painel da Cakto > Produtos > o produto > Links de checkout.
# Só são aceitas URLs https em pay.cakto.com.br.
CAKTO_CHECKOUT_MONTHLY_URL=https://pay.cakto.com.br/36h8hoh_1014418
CAKTO_CHECKOUT_YEARLY_URL=https://pay.cakto.com.br/ww6fjqv

# Segredo do webhook. A Cakto devolve este valor dentro do corpo de todo
# evento, no campo "secret", e é o que autoriza a atualização.
#
# É o único caminho autorizado a marcar uma clínica como pagante: sem
# ele, a rota /api/webhooks/cakto recusa tudo com 503. Gere um valor
# longo e aleatório (ex.: openssl rand -hex 32) e use o MESMO texto aqui
# e no campo "Secret" do webhook no painel da Cakto.
CAKTO_WEBHOOK_SECRET=

# Opcional. Só é necessário se um dia for preciso consultar a API da
# Cakto (conferir uma assinatura, cancelar pelo sistema). A integração
# atual não usa: checkout é link, confirmação é webhook.
# CAKTO_API_CLIENT_ID=
# CAKTO_API_CLIENT_SECRET=
