# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — Project Settings > API. Server-only, never expose
# to the browser. Used to bootstrap clinics and invite teammates.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used to build email confirmation / password reset links.
# Optional locally (falls back to the request host); set explicitly in
# production (e.g. https://app.esteticaos.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Cobrança (opcional)
#
# Nada aqui é obrigatório para rodar o sistema. Sem estas variáveis, a
# tela de Plano mostra o preço normalmente e o botão de pagamento avisa
# que a forma escolhida ainda está sendo liberada. Assinatura só é
# marcada como paga por confirmação do provedor, nunca pela interface.
# ---------------------------------------------------------------------

# Cartão de crédito recorrente, via Stripe.
STRIPE_SECRET_KEY=
# Assinatura do webhook. É o único caminho autorizado a marcar uma
# clínica como pagante.
STRIPE_WEBHOOK_SECRET=
# IDs dos preços cadastrados no Stripe (mensal e anual).
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_ID=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY_ID=

# Pix. Provedor ainda não escolhido: enquanto esta variável estiver
# vazia, o botão de Pix não gera cobrança nem QR Code.
PIX_PROVIDER_KEY=
